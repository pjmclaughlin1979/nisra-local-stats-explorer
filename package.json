{
  "name": "nisra-local-stats-explorer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:react": "npm run dev -w apps/react",
    "dev:svelte": "npm run dev -w apps/svelte",
    "build": "npm run build -w apps/react && npm run build -w apps/svelte && npm run build -w apps/profiles",
    "dev:profiles": "npm run dev -w apps/profiles"
  }
}
